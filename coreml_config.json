{
  "artifact": "layout_heron.mlpackage",
  "compiled_artifact": "layout_heron.mlmodelc",
  "base_model": "docling-project/docling-layout-heron",
  "coremltools_version": "8.3.0",
  "source_framework": "pytorch",
  "source_torch_version": "2.5.0",
  "model_type": "mlprogram",
  "compute_precision": "float16",
  "minimum_deployment_targets": {
    "macOS": "15.0",
    "iOS": "18.0",
    "iPadOS": "18.0",
    "macCatalyst": "18.0",
    "tvOS": "18.0",
    "visionOS": "2.0",
    "watchOS": "11.0"
  },
  "inputs": {
    "pixel_values": {
      "dtype": "float32",
      "shape": [1, 3, 640, 640],
      "range": [0.0, 1.0],
      "layout": "NCHW"
    }
  },
  "outputs": {
    "logits": {
      "dtype": "float16",
      "shape": [1, 300, 17]
    },
    "pred_boxes": {
      "dtype": "float16",
      "shape": [1, 300, 4],
      "format": "normalized cxcywh"
    }
  },
  "id2label": {
    "0": "caption",
    "1": "footnote",
    "2": "formula",
    "3": "list_item",
    "4": "page_footer",
    "5": "page_header",
    "6": "picture",
    "7": "section_header",
    "8": "table",
    "9": "text",
    "10": "title",
    "11": "document_index",
    "12": "code",
    "13": "checkbox_selected",
    "14": "checkbox_unselected",
    "15": "form",
    "16": "key_value_region"
  }
}
